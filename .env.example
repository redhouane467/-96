PORT=4000
JWT_SECRET=ضع_قيمة_عشوائية_قوية
ADMIN_EMAIL=admin@wassli.local
ADMIN_PASSWORD=Admin123456!

# VITE_API_URL — للتطوير المحلي فقط (npm run dev)، حيث الواجهة تعمل على
# منفذ منفصل (5173) عن السيرفر (4000). في هذه الحالة فقط، فعّل السطر التالي:
# VITE_API_URL=http://localhost:4000/api
#
# تحذير مهم لـ Render/الإنتاج: لا تضبط VITE_API_URL هناك إطلاقًا.
# Vite يخزّن قيمتها داخل ملفات JS النهائية وقت البناء (build time)، وليس وقت
# التشغيل. لو ضُبطت هذه القيمة على Render بنفس القيمة أعلاه، فسيحاول متصفح
# كل زائر الاتصال بـ "localhost:4000" الخاص بجهازه هو، وهذا يسبب خطأ
# "Failed to fetch" عند التسجيل/الدخول. بدون هذا المتغير، يعتمد الكود تلقائيًا
# على "/api" (نفس نطاق الموقع)، وهو الصحيح دائمًا على Render.
